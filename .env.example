# ANIME POSTER LAB — configuración local
# Copia este fichero a `.env` y ajusta los valores. NUNCA commitees `.env`.

# --- Servidor ---
APP_HOST=127.0.0.1
APP_PORT=8012
LOG_LEVEL=info

# --- Identidad pública (sonda /health/ y GET /) ---
APP_VERSION=2.5-AI

# --- CORS: lista EXPLÍCITA de orígenes permitidos (nunca "*" con credenciales) ---
# Separa por comas. En local se permiten los puertos típicos de frontend (Vite/CRA).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
