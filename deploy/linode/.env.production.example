# ANIME POSTER LAB — entorno de PRODUCCIÓN (Linode, 0-Docker)
# Este fichero se copia a /etc/<SVC>.env (0600) por SETUP_ALL.sh.
# NO commitear valores reales.

# --- Servidor (uvicorn escucha solo en loopback; nginx hace de proxy) ---
APP_HOST=127.0.0.1
APP_PORT=8012
LOG_LEVEL=info

# --- Identidad pública (GET / y /health/) ---
APP_VERSION=2.5-AI

# --- CORS: lista EXPLÍCITA de orígenes del frontend real, separados por comas ---
# Vacío => solo se permite localhost (deniega por defecto). Rellenar antes de exponer.
CORS_ALLOWED_ORIGINS=
